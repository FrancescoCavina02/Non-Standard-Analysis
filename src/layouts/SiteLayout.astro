---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Non-Standard Analysis',
  description = 'Intuition, formal reasoning, and interactive explanations for non-standard analysis.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title === 'Non-Standard Analysis' ? title : `${title} | Non-Standard Analysis`}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Non-Standard Analysis home">
        <span class="wordmark-mark">*</span>
        <span>NSA / field notes</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href={`${base}#concepts`}>Concepts</a>
        <a href={`${base}#method`}>Method</a>
        <a href="https://github.com/FrancescoCavina02/Non-Standard-Analysis">Source</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Francesco Cavina and Bernd Heidergott</p>
      <p>Explanations are generated as drafts and published only after review.</p>
    </footer>
  </body>
</html>
